# Сборка: dist/ в репозитории нужен — OpenCode ставит плагины с
# ignoreScripts, поэтому prepare-скрипт при установке не выполняется.
# После правки исходников: npm run compile && git add dist && git commit

# Зависимости
node_modules/

# Логи и временные файлы
*.log
*.tgz
screen-*.log
keys.log
tui-run.log
palette.log
slash.log
dlg-*.log
esc-*.log

# Локальное окружение
.env
.env.*
!.env.example

# Редакторы и ОС
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
