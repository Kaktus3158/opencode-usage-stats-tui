{
  "name": "opencode-usage-stats-tui",
  "version": "0.1.0",
  "description": "Token usage statistics for the OpenCode TUI: requests, tokens and cost by model, session and day",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run compile",
    "pack:check": "npm pack --dry-run",
    "install:local": "node scripts/install-local.mjs",
    "prepublishOnly": "npm run compile"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "usage",
    "stats",
    "statistics",
    "tokens",
    "cost",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaktus3158/opencode-usage-stats-tui.git"
  },
  "bugs": {
    "url": "https://github.com/Kaktus3158/opencode-usage-stats-tui/issues"
  },
  "homepage": "https://github.com/Kaktus3158/opencode-usage-stats-tui#readme",
  "engines": {
    "node": ">=22.13.0",
    "opencode": ">=2.2.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/client": "^2.2.7",
    "@opencode/plugin": "^2.2.7",
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "babel-preset-solid": "^1.9.16",
    "solid-js": "^1.9.19",
    "typescript": "^5.9.2"
  }
}
